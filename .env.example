# Nginx Proxy Manager API (панель на порту 81)
# NPM_EMAIL/NPM_PASSWORD: админ NPM создаётся автоматически при первом старте
# (передаются в контейнер как INITIAL_ADMIN_EMAIL/INITIAL_ADMIN_PASSWORD)
NPM_URL=http://localhost:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=changeme

# Домен по умолчанию для тасок: <task-name>.<BASE_DOMAIN>
BASE_DOMAIN=localhost

# Порт внутри контейнера таски по умолчанию
DEFAULT_FORWARD_PORT=8000
DEFAULT_FORWARD_SCHEME=http

# Внешняя схема, по которой пользователи ходят на NPM (http|https)
# Для https нужен wildcard-сертификат на *.<BASE_DOMAIN>
# Если указаны DNS_PROVIDER и DNS_PROVIDER_CREDENTIALS — сертификат выпускается
# автоматически через Let's Encrypt (DNS challenge) при поднятии стека
EXTERNAL_SCHEME=http

# DNS-провайдер для wildcard-сертификата (https). Ключ из списка ниже.
# Пример: DNS_PROVIDER=duckdns
# DNS_PROVIDER=duckdns
# Credentials для провайдера — содержимое credentials-файла (одной строкой, \n -> пробелы).
# Пример для duckdns: DNS_PROVIDER_CREDENTIALS="dns_duckdns_token=your-token"
# DNS_PROVIDER_CREDENTIALS=

# Свои сертификаты вместо Let's Encrypt (https).
# Если certs/fullchain.pem и certs/privkey.pem существуют — install.sh предложит их использовать.
# USE_CUSTOM_CERT=1
# CERT_FILE=certs/fullchain.pem
# CERT_KEY_FILE=certs/privkey.pem
# CERT_CHAIN_FILE=certs/chain.pem

# --- Список DNS-провайдеров NPM (ключ: имя + пример credentials) ---

# CTFd (по умолчанию публикуется на ctf.<BASE_DOMAIN>)
CTFD_DOMAIN=
CTFD_FORWARD_HOST=ctfd
CTFD_FORWARD_PORT=8000

# === Первоначальный setup CTFd (используется sync-ctfd.sh) ===
# URL CTFd изнутри docker-сети (или http://localhost:8000 для ручного запуска)
CTFD_URL=http://ctfd:8000
# Админ CTFd, создаётся при setup
CTF_ADMIN_NAME=admin
CTF_ADMIN_EMAIL=admin@example.com
CTF_ADMIN_PASSWORD=changeme

# Параметры события
CTF_NAME="My CTF"
CTF_DESCRIPTION=
CTF_MODE=users            # users | teams
CTF_CHALLENGE_VISIBILITY=private   # public | private | admins
CTF_ACCOUNT_VISIBILITY=public      # public | private | admins
CTF_SCORE_VISIBILITY=public        # public | private | hidden | admins
CTF_REGISTRATION_VISIBILITY=public # public | private | mlc
CTF_START=
CTF_END=
CTF_TEAM_SIZE=
CTF_VERIFY_EMAILS=
CTF_THEME=core-beta
#   acmedns          ACME-DNS                     creds: dns_acmedns_api_url = http://acmedns-server/ | dns_acmedns_registration_file = /data/acme-registration.json
#   active24         Active24                     creds: dns_active24_api_key = <identifier> | dns_active24_secret = <secret>
#   aliyun           Aliyun                       creds: dns_aliyun_access_key = 12345678 | dns_aliyun_access_key_secret = 1234567890abcdef1234567890abcdef
#   arvan            ArvanCloud                   creds: dns_arvan_key = Apikey xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   azure            Azure                        creds: # This plugin supported API authentication using either Service Principals or utilizing a Managed Identity assigned to the virtual machine. | # Regardless which authentication method used, the identity will need the “DNS Zone Contributor” role assigned to it. | # As multiple Azure DNS Zones in multiple resource groups can exist, the config file needs a mapping of zone to resource group ID. Multiple zones -> ID mappings can be listed by using the key dns_azure_zoneX where X is a unique number. At least 1 zone mapping is required. |  | # Using a service principal (option 1) | dns_azure_sp_client_id = 912ce44a-0156-4669-ae22-c16a17d34ca5 | dns_azure_sp_client_secret = E-xqXU83Y-jzTI6xe9fs2YC~mck3ZzUih9 | dns_azure_tenant_id = ed1090f3-ab18-4b12-816c-599af8a88cf7 |  | # Using used assigned MSI (option 2) | # dns_azure_msi_client_id = 912ce44a-0156-4669-ae22-c16a17d34ca5 |  | # Using system assigned MSI (option 3) | # dns_azure_msi_system_assigned = true |  | # Zones (at least one always required) | dns_azure_zone1 = example.com:/subscriptions/c135abce-d87d-48df-936c-15596c6968a5/resourceGroups/dns1 | dns_azure_zone2 = example.org:/subscriptions/99800903-fb14-4992-9aff-12eaf2744622/resourceGroups/dns2
